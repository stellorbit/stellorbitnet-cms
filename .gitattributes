# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force text files to LF
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.astro text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.env* text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Binary files (do not convert line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
